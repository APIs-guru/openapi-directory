    "/data/crypto": {
      "post": {
        "summary": "Get current prices for one or more cryptocurrencies in USD with 24h change data.",
        "description": "Real-time cryptocurrency prices. Returns price, 24h change for Bitcoin, Ethereum, Solana, and 100+ coins. Pay per request in USDC on Base via x402.",
        "x-keywords": [
          "crypto price",
          "coin price",
          "bitcoin price",
          "ethereum price",
          "real-time price",
          "market data",
          "cryptocurrency",
          "24h change",
          "token price"
        ],
        "x-use-cases": [
          "get the current price of Bitcoin in USD",
          "look up Ethereum price",
          "check prices for multiple coins",
          "retrieve 24h price change"
        ],
        "x-auth-mode": "paid",
        "x-price": "0.02",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "coins": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "coins"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cryptocurrency prices"
          },
          "402": {
            "description": "Payment required"
          }
        }
      }
    },
