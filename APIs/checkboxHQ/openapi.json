    "/api/v1/verify_disposable/": {
      "post": {
        "tags": [
          "Disposable Email Verification"
        ],
        "summary": "Verify Email",
        "description": "Verify if the domain of the provided email is a disposable email provider. This means that the email address is likely temporary and not intended for long-term use.\nIt does not guarantee that the email address itself is valid or deliverable.\n\nThis API endpoint consumes one credit from your API token quota.",
        "operationId": "verify_email_api_v1_verify_disposable__post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailVerifyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailVerifyResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/verify_dns/": {
      "post": {
        "tags": [
          "Domain DNS Verification"
        ],
        "summary": "Verify Email",
        "description": "Verify if the domain of the provided email has MX and A records. This means that the domain is configured to receive emails and has an IP address.\nIt does not guarantee that the email address itself is valid or deliverable.\n\nMX records indicate that the domain is set up to handle email, while A records indicate that the domain has an associated IP address.\n\nThis API endpoint is richer and consumes two credits from your API token quota.",
        "operationId": "verify_email_api_v1_verify_dns__post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailVerifyDNSRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailVerifyDNSResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/verify_public_provider/": {
      "post": {
        "tags": [
          "Public Email Provider Verification"
        ],
        "summary": "Verify Email",
        "description": "Verify if the domain of the provided email is a public email provider. This means that the email address is likely from a well-known email service provider.\nIt does not guarantee that the email address itself is valid or deliverable.\n\nThis API endpoint consumes one credit from your API token quota.",
        "operationId": "verify_email_api_v1_verify_public_provider__post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "X-Api-Key"
            }
